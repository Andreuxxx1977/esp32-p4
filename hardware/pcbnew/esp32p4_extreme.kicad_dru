# ---------------------------------------------------------------- SoC fan-out (0.35 mm pitch)
# Inside the U1 courtyard the netclass clearances cannot be met: neck down to the HDI minimum
# (pads, tracks, vias only -- pours keep their own clearance).
(rule "u1_fanout_clearance"
    (constraint clearance (min 0.09mm))
    (condition "A.intersectsCourtyard('U1') && A.Type != 'Zone' && B.Type != 'Zone'"))
(rule "u1_fanout_track_width"
    (constraint track_width (min 0.09mm))
    (condition "A.Type == 'Track' && A.intersectsCourtyard('U1')"))

# ---------------------------------------------------------------- footprint-intrinsic
# GCT USB4105 land pattern: its own NPTH locating pegs sit 0.194 mm from pads A1/B12/
# A12/B1 (manufacturer drawing). Relax hole clearance only *inside* those footprints.
(rule "usb4105_own_npth_clearance"
    (constraint hole_clearance (min 0.15mm))
    (condition "(A.memberOfFootprint('J1') && B.memberOfFootprint('J1')) || (A.memberOfFootprint('J2') && B.memberOfFootprint('J2')) || (A.memberOfFootprint('J3') && B.memberOfFootprint('J3'))"))

# Dense 0402 arrays (SoC ring: 0.34 mm between neighbouring pads) and the USB-C GND pins
# leave room for only one thermal spoke per pad; accept 1 instead of the board default 2.
(rule "dense_passives_single_spoke"
    (constraint min_resolved_spokes 1)
    (condition "A.Type == 'Pad' && (A.memberOfFootprint('C1') || A.memberOfFootprint('C2') || A.memberOfFootprint('C3') || A.memberOfFootprint('C4') || A.memberOfFootprint('C5') || A.memberOfFootprint('C6') || A.memberOfFootprint('C7') || A.memberOfFootprint('C8') || A.memberOfFootprint('C9') || A.memberOfFootprint('C10') || A.memberOfFootprint('C11') || A.memberOfFootprint('C12') || A.memberOfFootprint('C13') || A.memberOfFootprint('C14') || A.memberOfFootprint('C15') || A.memberOfFootprint('C16') || A.memberOfFootprint('C17') || A.memberOfFootprint('C18') || A.memberOfFootprint('C19') || A.memberOfFootprint('C20') || A.memberOfFootprint('C21') || A.memberOfFootprint('C22') || A.memberOfFootprint('C23') || A.memberOfFootprint('C24') || A.memberOfFootprint('C25') || A.memberOfFootprint('C26') || A.memberOfFootprint('C27') || A.memberOfFootprint('C28') || A.memberOfFootprint('C29') || A.memberOfFootprint('C30') || A.memberOfFootprint('C31') || A.memberOfFootprint('C32') || A.memberOfFootprint('C33') || A.memberOfFootprint('C34') || A.memberOfFootprint('C35') || A.memberOfFootprint('C36') || A.memberOfFootprint('C37') || A.memberOfFootprint('C38') || A.memberOfFootprint('C39') || A.memberOfFootprint('C40') || A.memberOfFootprint('C41') || A.memberOfFootprint('R1') || A.memberOfFootprint('R2') || A.memberOfFootprint('R3') || A.memberOfFootprint('R4') || A.memberOfFootprint('R5') || A.memberOfFootprint('R6') || A.memberOfFootprint('C42') || A.memberOfFootprint('R7') || A.memberOfFootprint('R8') || A.memberOfFootprint('R9') || A.memberOfFootprint('R10') || A.memberOfFootprint('R11') || A.memberOfFootprint('R12') || A.memberOfFootprint('C43') || A.memberOfFootprint('C44') || A.memberOfFootprint('R13') || A.memberOfFootprint('R14') || A.memberOfFootprint('R15') || A.memberOfFootprint('R16') || A.memberOfFootprint('R17') || A.memberOfFootprint('R18') || A.memberOfFootprint('R19') || A.memberOfFootprint('C45') || A.memberOfFootprint('C46') || A.memberOfFootprint('R20') || A.memberOfFootprint('R21') || A.memberOfFootprint('C48') || A.memberOfFootprint('C52') || A.memberOfFootprint('C57') || A.memberOfFootprint('R22') || A.memberOfFootprint('R23') || A.memberOfFootprint('R24') || A.memberOfFootprint('R25') || A.memberOfFootprint('J1') || A.memberOfFootprint('R26') || A.memberOfFootprint('R27') || A.memberOfFootprint('R28') || A.memberOfFootprint('R29') || A.memberOfFootprint('J2') || A.memberOfFootprint('R30') || A.memberOfFootprint('R31') || A.memberOfFootprint('R32') || A.memberOfFootprint('R33') || A.memberOfFootprint('R34') || A.memberOfFootprint('C60') || A.memberOfFootprint('C61') || A.memberOfFootprint('C62') || A.memberOfFootprint('C63') || A.memberOfFootprint('C64') || A.memberOfFootprint('R35') || A.memberOfFootprint('R36') || A.memberOfFootprint('J3') || A.memberOfFootprint('R37') || A.memberOfFootprint('R38') || A.memberOfFootprint('R39') || A.memberOfFootprint('R40') || A.memberOfFootprint('R41') || A.memberOfFootprint('R42') || A.memberOfFootprint('R43') || A.memberOfFootprint('R44') || A.memberOfFootprint('R45') || A.memberOfFootprint('R46') || A.memberOfFootprint('R47') || A.memberOfFootprint('C66') || A.memberOfFootprint('C67') || A.memberOfFootprint('R48') || A.memberOfFootprint('R49') || A.memberOfFootprint('R50') || A.memberOfFootprint('R51') || A.memberOfFootprint('R52') || A.memberOfFootprint('C68') || A.memberOfFootprint('C69') || A.memberOfFootprint('C70') || A.memberOfFootprint('C71') || A.memberOfFootprint('C72') || A.memberOfFootprint('C73') || A.memberOfFootprint('C74') || A.memberOfFootprint('R53') || A.memberOfFootprint('R54') || A.memberOfFootprint('R55') || A.memberOfFootprint('R56') || A.memberOfFootprint('C75') || A.memberOfFootprint('C76') || A.memberOfFootprint('R57') || A.memberOfFootprint('R58') || A.memberOfFootprint('R59') || A.memberOfFootprint('R60') || A.memberOfFootprint('R61') || A.memberOfFootprint('R62') || A.memberOfFootprint('R63') || A.memberOfFootprint('R64') || A.memberOfFootprint('C77') || A.memberOfFootprint('R65') || A.memberOfFootprint('R66') || A.memberOfFootprint('R67') || A.memberOfFootprint('R68') || A.memberOfFootprint('R69') || A.memberOfFootprint('R70') || A.memberOfFootprint('R71') || A.memberOfFootprint('C79') || A.memberOfFootprint('R72') || A.memberOfFootprint('R73') || A.memberOfFootprint('R74') || A.memberOfFootprint('R75') || A.memberOfFootprint('R76') || A.memberOfFootprint('R77') || A.memberOfFootprint('C80') || A.memberOfFootprint('C81') || A.memberOfFootprint('R78') || A.memberOfFootprint('R79') || A.memberOfFootprint('R80') || A.memberOfFootprint('R81') || A.memberOfFootprint('R82') || A.memberOfFootprint('R83') || A.memberOfFootprint('C82') || A.memberOfFootprint('C83') || A.memberOfFootprint('R84') || A.memberOfFootprint('R85') || A.memberOfFootprint('R86') || A.memberOfFootprint('R87') || A.memberOfFootprint('R88') || A.memberOfFootprint('R89') || A.memberOfFootprint('R90') || A.memberOfFootprint('R91') || A.memberOfFootprint('R92') || A.memberOfFootprint('R93') || A.memberOfFootprint('R94') || A.memberOfFootprint('C85') || A.memberOfFootprint('R95') || A.memberOfFootprint('C86'))"))

# Exposed pads (with their thermal-via pads, same number) connect solid, like U1's EPAD.
(rule "exposed_pads_solid"
    (constraint zone_connection solid)
    (condition "A.Type == 'Pad' && ((A.memberOfFootprint('U2') && A.Pad_Number == '9') || (A.memberOfFootprint('U3') && A.Pad_Number == '17') || (A.memberOfFootprint('U6') && A.Pad_Number == '25') || (A.memberOfFootprint('U5') && A.Pad_Number == '25'))"))

# ---------------------------------------------------------------- (2) differential pairs
(rule "usb_90_diff_pair"
    (constraint diff_pair_gap (min 0.135mm) (opt 0.150mm) (max 0.165mm))
    (constraint diff_pair_uncoupled (max 3.0mm))
    (constraint track_width (min 0.135mm) (opt 0.150mm))
    (condition "A.NetClass == 'USB_90' && A.inDiffPair('*')"))
(rule "mipi_100_diff_pair"
    (constraint diff_pair_gap (min 0.180mm) (opt 0.200mm) (max 0.220mm))
    (constraint diff_pair_uncoupled (max 1.5mm))
    (constraint track_width (min 0.122mm) (opt 0.135mm))
    (condition "A.NetClass == 'MIPI_100' && A.inDiffPair('*')"))
(rule "eth_100_diff_pair"
    (constraint diff_pair_gap (min 0.180mm) (opt 0.200mm) (max 0.220mm))
    (constraint diff_pair_uncoupled (max 5.0mm))
    (constraint track_width (min 0.122mm) (opt 0.135mm))
    (condition "A.NetClass == 'ETH_100' && A.inDiffPair('*')"))
# NOTE: KiCad recognises a pair only by the suffixes P/N or +/-. The USB nets are named
# ..._DP/..._DM, so the USB_90 rule above stays inert until they are renamed (e.g. USB1_D_P /
# USB1_D_N) in board_spec.py; the router's diff-pair mode needs the same rename.

# ---------------------------------------------------------------- (3) skew / length matching
# Intra-pair skew <= 0.254 mm (10 mil). One rule per pair: a skew rule measures all nets it
# matches as one group (KiCad 8 adds '(within_diff_pairs)'; per-pair rules also work in 7).
(rule "skew_usb1_d_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'USB1_D_P' || A.NetName == 'USB1_D_N'"))
(rule "skew_usbhs_d_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'USBHS_D_P' || A.NetName == 'USBHS_D_N'"))
(rule "skew_usb2_d_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'USB2_D_P' || A.NetName == 'USB2_D_N'"))
(rule "skew_usb3_d_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'USB3_D_P' || A.NetName == 'USB3_D_N'"))
(rule "skew_usj_d_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'USJ_D_P' || A.NetName == 'USJ_D_N'"))
(rule "skew_csi_d0_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'CSI_D0_P' || A.NetName == 'CSI_D0_N'"))
(rule "skew_csi_d1_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'CSI_D1_P' || A.NetName == 'CSI_D1_N'"))
(rule "skew_csi_clk_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'CSI_CLK_P' || A.NetName == 'CSI_CLK_N'"))
(rule "skew_cam_d0_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'CAM_D0_P' || A.NetName == 'CAM_D0_N'"))
(rule "skew_cam_d1_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'CAM_D1_P' || A.NetName == 'CAM_D1_N'"))
(rule "skew_cam_clk_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'CAM_CLK_P' || A.NetName == 'CAM_CLK_N'"))
(rule "skew_dsi_d0_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'DSI_D0_P' || A.NetName == 'DSI_D0_N'"))
(rule "skew_dsi_d1_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'DSI_D1_P' || A.NetName == 'DSI_D1_N'"))
(rule "skew_dsi_clk_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'DSI_CLK_P' || A.NetName == 'DSI_CLK_N'"))
(rule "skew_disp_d0_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'DISP_D0_P' || A.NetName == 'DISP_D0_N'"))
(rule "skew_disp_d1_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'DISP_D1_P' || A.NetName == 'DISP_D1_N'"))
(rule "skew_disp_clk_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'DISP_CLK_P' || A.NetName == 'DISP_CLK_N'"))
(rule "skew_eth_tx_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'ETH_TX_P' || A.NetName == 'ETH_TX_N'"))
(rule "skew_eth_rx_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'ETH_RX_P' || A.NetName == 'ETH_RX_N'"))

# MIPI D-PHY inter-lane matching (Espressif: lanes of one link within 0.762 mm / 30 mil).
# KiCad measures each net separately and cannot sum across the 0R series resistors, so the
# SoC-side and connector-side segments are matched separately (tighten on the long side).
(rule "mipi_csi_lane_matching"
    (constraint skew (max 0.762mm))
    (condition "A.NetName == 'CSI_D0_P' || A.NetName == 'CSI_D0_N' || A.NetName == 'CSI_D1_P' || A.NetName == 'CSI_D1_N' || A.NetName == 'CSI_CLK_P' || A.NetName == 'CSI_CLK_N'"))
(rule "mipi_cam_lane_matching"
    (constraint skew (max 0.762mm))
    (condition "A.NetName == 'CAM_D0_P' || A.NetName == 'CAM_D0_N' || A.NetName == 'CAM_D1_P' || A.NetName == 'CAM_D1_N' || A.NetName == 'CAM_CLK_P' || A.NetName == 'CAM_CLK_N'"))
(rule "mipi_dsi_lane_matching"
    (constraint skew (max 0.762mm))
    (condition "A.NetName == 'DSI_D0_P' || A.NetName == 'DSI_D0_N' || A.NetName == 'DSI_D1_P' || A.NetName == 'DSI_D1_N' || A.NetName == 'DSI_CLK_P' || A.NetName == 'DSI_CLK_N'"))
(rule "mipi_disp_lane_matching"
    (constraint skew (max 0.762mm))
    (condition "A.NetName == 'DISP_D0_P' || A.NetName == 'DISP_D0_N' || A.NetName == 'DISP_D1_P' || A.NetName == 'DISP_D1_N' || A.NetName == 'DISP_CLK_P' || A.NetName == 'DISP_CLK_N'"))

# SDIO: CMD/D0-D3 within +/-1.27 mm (50 mil) of SD_CLK. KiCad's skew is measured against the
# longest net of the group (not against CLK), so a 1.27 mm group skew is the closest
# expressible form; it is stricter than or equal to the intent.
(rule "sdio_card_side_matching"
    (constraint skew (max 1.27mm))
    (condition "A.NetName == 'SD_CLK_C' || A.NetName == 'SD_CMD_C' || A.NetName == 'SD_D0_C' || A.NetName == 'SD_D1_C' || A.NetName == 'SD_D2_C' || A.NetName == 'SD_D3_C'"))
(rule "sdio_soc_side_matching"
    (constraint skew (max 1.27mm))
    (condition "A.NetName == 'SD_CLK' || A.NetName == 'SD_CMD' || A.NetName == 'SD_D0' || A.NetName == 'SD_D1' || A.NetName == 'SD_D2' || A.NetName == 'SD_D3'"))

# ---------------------------------------------------------------- (4) thermal vias
# 7x7 GND vias in the EPAD ('U1_EPAD_VIAS' rule area): 0.3 mm drill / 0.6 mm pad, IPC-4761 Type VII (resin-filled + copper-capped, VIPPO).
(rule "thermal_via_size"
    (constraint hole_size (min 0.3mm) (max 0.3mm))
    (constraint via_diameter (min 0.6mm))
    (condition "A.Type == 'Via' && A.intersectsArea('U1_EPAD_VIAS')"))

# ---------------------------------------------------------------- (5) M2.5 heatsink holes
# H1..H4 also carry 'H1_KEEPOUT'.. rule areas (R = 3.5 mm, no tracks/vias).
(rule "m25_hole_to_hole"
    (constraint hole_to_hole (min 0.4mm))
    (condition "A.memberOfFootprint('H1') || A.memberOfFootprint('H2') || A.memberOfFootprint('H3') || A.memberOfFootprint('H4')"))
(rule "m25_hole_clearance"
    (constraint hole_clearance (min 0.5mm))
    (constraint clearance (min 0.3mm))
    (condition "(A.memberOfFootprint('H1') || A.memberOfFootprint('H2') || A.memberOfFootprint('H3') || A.memberOfFootprint('H4')) && B.NetName != 'GND'"))

# ---------------------------------------------------------------- aspirational (comments only)
# * Keep-out height limit (0.60 mm) is mechanical; DRC cannot see component height.
# * Microvia-only fan-out inside U1: (condition "A.Via_Type == 'Micro'") -- property value
#   spelling differs between versions, so the board minimums in the .kicad_pro cover it.
# * Total MIPI/SDIO length through the 0R resistors needs net chaining (not in KiCad 8/9).
