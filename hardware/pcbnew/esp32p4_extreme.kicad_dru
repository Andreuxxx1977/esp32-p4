(version 1)
# ESP32-P4 Extreme Performance -- custom DRC rules.
# GENERATED from hardware/lib/board_spec.py by hardware/pcbnew/layout_plan.py -- do not edit;
# re-run `python3 -m hardware.pcbnew.layout_plan dru` after changing the spec.
# Syntax: KiCad 7+ custom rules (intersectsArea / intersectsCourtyard / inDiffPair).

# ---------------------------------------------------------------- (1) heatsink keep-out
# Only U1 and 0402 passives (<= 0.6 mm, board_spec.is_keepout_exempt) may touch the 25 x 25 mm area
# 'HEATSINK_KEEPOUT' (F.Cu rule area). intersectsArea() tests a footprint's courtyard on the
# area's side, so bottom-side parts under the SoC are not affected (the heatsink is on top).
# 169 exempt references are listed explicitly (no wildcards, so the condition is
# unambiguous in every KiCad version).
(rule "heatsink_keepout_footprints"
    (constraint disallow footprint)
    (condition "A.intersectsArea('HEATSINK_KEEPOUT') && A.Reference != 'C1' && A.Reference != 'C2' && A.Reference != 'C3' && A.Reference != 'C4' && A.Reference != 'C5' && A.Reference != 'C6' && A.Reference != 'C7' && A.Reference != 'C8' && A.Reference != 'C9' && A.Reference != 'C10' && A.Reference != 'C11' && A.Reference != 'C12' && A.Reference != 'C13' && A.Reference != 'C14' && A.Reference != 'C15' && A.Reference != 'C16' && A.Reference != 'C17' && A.Reference != 'C18' && A.Reference != 'C19' && A.Reference != 'C20' && A.Reference != 'C21' && A.Reference != 'C22' && A.Reference != 'C23' && A.Reference != 'C24' && A.Reference != 'C25' && A.Reference != 'C26' && A.Reference != 'C27' && A.Reference != 'C28' && A.Reference != 'C29' && A.Reference != 'C30' && A.Reference != 'C31' && A.Reference != 'C32' && A.Reference != 'C33' && A.Reference != 'C34' && A.Reference != 'C35' && A.Reference != 'C36' && A.Reference != 'C37' && A.Reference != 'C38' && A.Reference != 'C39' && A.Reference != 'C40' && A.Reference != 'C41' && A.Reference != 'C42' && A.Reference != 'C43' && A.Reference != 'C44' && A.Reference != 'C45' && A.Reference != 'C46' && A.Reference != 'C48' && A.Reference != 'C52' && A.Reference != 'C57' && A.Reference != 'C60' && A.Reference != 'C61' && A.Reference != 'C62' && A.Reference != 'C63' && A.Reference != 'C64' && A.Reference != 'C66' && A.Reference != 'C67' && A.Reference != 'C68' && A.Reference != 'C69' && A.Reference != 'C70' && A.Reference != 'C71' && A.Reference != 'C72' && A.Reference != 'C73' && A.Reference != 'C74' && A.Reference != 'C75' && A.Reference != 'C76' && A.Reference != 'C77' && A.Reference != 'C79' && A.Reference != 'C80' && A.Reference != 'C81' && A.Reference != 'C82' && A.Reference != 'C83' && A.Reference != 'C85' && A.Reference != 'C86' && A.Reference != 'R1' && A.Reference != 'R2' && A.Reference != 'R3' && A.Reference != 'R4' && A.Reference != 'R5' && A.Reference != 'R6' && A.Reference != 'R7' && A.Reference != 'R8' && A.Reference != 'R9' && A.Reference != 'R10' && A.Reference != 'R11' && A.Reference != 'R12' && A.Reference != 'R13' && A.Reference != 'R14' && A.Reference != 'R15' && A.Reference != 'R16' && A.Reference != 'R17' && A.Reference != 'R18' && A.Reference != 'R19' && A.Reference != 'R20' && A.Reference != 'R21' && A.Reference != 'R22' && A.Reference != 'R23' && A.Reference != 'R24' && A.Reference != 'R25' && A.Reference != 'R26' && A.Reference != 'R27' && A.Reference != 'R28' && A.Reference != 'R29' && A.Reference != 'R30' && A.Reference != 'R31' && A.Reference != 'R32' && A.Reference != 'R33' && A.Reference != 'R34' && A.Reference != 'R35' && A.Reference != 'R36' && A.Reference != 'R37' && A.Reference != 'R38' && A.Reference != 'R39' && A.Reference != 'R40' && A.Reference != 'R41' && A.Reference != 'R42' && A.Reference != 'R43' && A.Reference != 'R44' && A.Reference != 'R45' && A.Reference != 'R46' && A.Reference != 'R47' && A.Reference != 'R48' && A.Reference != 'R49' && A.Reference != 'R50' && A.Reference != 'R51' && A.Reference != 'R52' && A.Reference != 'R53' && A.Reference != 'R54' && A.Reference != 'R55' && A.Reference != 'R56' && A.Reference != 'R57' && A.Reference != 'R58' && A.Reference != 'R59' && A.Reference != 'R60' && A.Reference != 'R61' && A.Reference != 'R62' && A.Reference != 'R63' && A.Reference != 'R64' && A.Reference != 'R65' && A.Reference != 'R66' && A.Reference != 'R67' && A.Reference != 'R68' && A.Reference != 'R69' && A.Reference != 'R70' && A.Reference != 'R71' && A.Reference != 'R72' && A.Reference != 'R73' && A.Reference != 'R74' && A.Reference != 'R75' && A.Reference != 'R76' && A.Reference != 'R77' && A.Reference != 'R78' && A.Reference != 'R79' && A.Reference != 'R80' && A.Reference != 'R81' && A.Reference != 'R82' && A.Reference != 'R83' && A.Reference != 'R84' && A.Reference != 'R85' && A.Reference != 'R86' && A.Reference != 'R87' && A.Reference != 'R88' && A.Reference != 'R89' && A.Reference != 'R90' && A.Reference != 'R91' && A.Reference != 'R92' && A.Reference != 'R93' && A.Reference != 'R94' && A.Reference != 'R95' && A.Reference != 'U1'"))

# ---------------------------------------------------------------- footprint-intrinsic
# GCT USB4105 land pattern: its own NPTH locating pegs sit 0.194 mm from pads A1/B12/
# A12/B1 (manufacturer drawing). Relax hole clearance only *inside* those footprints.
(rule "usb4105_own_npth_clearance"
    (constraint hole_clearance (min 0.15mm))
    (condition "(A.memberOfFootprint('J1') && B.memberOfFootprint('J1')) || (A.memberOfFootprint('J2') && B.memberOfFootprint('J2')) || (A.memberOfFootprint('J3') && B.memberOfFootprint('J3'))"))

# Dense 0402 arrays, the USB-C GND pins and the 0.5 mm-pitch FPC / QFN GND pins leave room
# for only one thermal spoke once the tracks are in; accept 1 instead of the board default 2
# (the plane connection of the 0402 and larger GND pads is their via in pad anyway).
(rule "single_spoke_ok"
    (constraint min_resolved_spokes 1)
    (condition "A.Type == 'Pad'"))

# Exposed pads (with their thermal-via pads, same number) connect solid, like U1's EPAD.
(rule "exposed_pads_solid"
    (constraint zone_connection solid)
    (condition "A.Type == 'Pad' && ((A.memberOfFootprint('U2') && A.Pad_Number == '9') || (A.memberOfFootprint('U3') && A.Pad_Number == '17') || (A.memberOfFootprint('U6') && A.Pad_Number == '25') || (A.memberOfFootprint('U5') && A.Pad_Number == '25'))"))

# ---------------------------------------------------------------- (2) differential pairs
(rule "usb_90_diff_pair"
    (constraint diff_pair_gap (min 0.135mm) (opt 0.150mm) (max 0.165mm))
    (constraint diff_pair_uncoupled (max 3.0mm))
    (constraint track_width (min 0.135mm) (opt 0.150mm))
    (condition "A.NetClass == 'USB_90' && A.inDiffPair('*')"))
(rule "mipi_100_diff_pair"
    (constraint diff_pair_gap (min 0.180mm) (opt 0.200mm) (max 0.220mm))
    (constraint diff_pair_uncoupled (max 1.5mm))
    (constraint track_width (min 0.122mm) (opt 0.135mm))
    (condition "A.NetClass == 'MIPI_100' && A.inDiffPair('*')"))
(rule "eth_100_diff_pair"
    (constraint diff_pair_gap (min 0.180mm) (opt 0.200mm) (max 0.220mm))
    (constraint diff_pair_uncoupled (max 5.0mm))
    (constraint track_width (min 0.122mm) (opt 0.135mm))
    (condition "A.NetClass == 'ETH_100' && A.inDiffPair('*')"))

# A 90-ohm USB pair is 0.15 mm wide at a 0.15 mm gap, below the USB_90 clearance (0.2 mm,
# kept to every other net): between the two nets of one pair the gap is the clearance.
(rule "usb_90_pair_gap_clearance"
    (constraint clearance (min 0.135mm))
    (condition "(A.inDiffPair('USB1_D') && B.inDiffPair('USB1_D')) || (A.inDiffPair('USBHS_D') && B.inDiffPair('USBHS_D')) || (A.inDiffPair('USB2_D') && B.inDiffPair('USB2_D')) || (A.inDiffPair('USB3_D') && B.inDiffPair('USB3_D')) || (A.inDiffPair('USJ_D') && B.inDiffPair('USJ_D'))"))

# ---------------------------------------------------------------- SoC breakout (heatsink area)
# Between U1's pad ring and the edge of the 25 x 25 mm heatsink keep-out sit the 0402
# decoupling ring and the 0R links, about 1 mm apart: the 0.2 mm clearance of the high-speed
# classes does not fit between them. Inside 'HEATSINK_KEEPOUT' (F.Cu) every clearance necks down
# to 0.1 mm for tracks, pads and vias, like a BGA breakout; pours keep their own
# clearance and the netclass clearances apply again outside the area.
(rule "soc_breakout_clearance"
    (constraint clearance (min 0.1mm))
    (condition "A.intersectsArea('HEATSINK_KEEPOUT') && A.Type != 'Zone' && B.Type != 'Zone'"))

# The same neck-down inside the courtyard of every other part with a pin pitch of 0.5 mm or less
# (FPC and USB-C connectors, QFN PHY / hub, ESD arrays): a track leaving such a pin runs between
# the neighbouring pins and the parts in front of them.
(rule "fine_pitch_fanout_clearance"
    (constraint clearance (min 0.1mm))
    (condition "(A.intersectsCourtyard('J1') || A.intersectsCourtyard('J2') || A.intersectsCourtyard('J3') || A.intersectsCourtyard('J_CAM') || A.intersectsCourtyard('J_DSI') || A.intersectsCourtyard('U10') || A.intersectsCourtyard('U11') || A.intersectsCourtyard('U3') || A.intersectsCourtyard('U5') || A.intersectsCourtyard('U6')) && A.Type != 'Zone' && B.Type != 'Zone'"))

# ---------------------------------------------------------------- SoC fan-out (0.35 mm pitch)
# Inside the U1 courtyard the netclass clearances cannot be met: neck down to the HDI minimum
# (pads, tracks, vias only -- pours keep their own clearance). The pairs leave U1 as 0.10 mm
# stubs on the pad pitch. These rules come after the pair rules: later rules take precedence.
(rule "u1_fanout_clearance"
    (constraint clearance (min 0.09mm))
    (condition "A.intersectsCourtyard('U1') && A.Type != 'Zone' && B.Type != 'Zone'"))
(rule "u1_fanout_track_width"
    (constraint track_width (min 0.09mm))
    (condition "A.Type == 'Track' && A.intersectsCourtyard('U1')"))
(rule "u1_fanout_diff_pair_gap"
    (constraint diff_pair_gap (min 0.09mm) (opt 0.25mm) (max 0.5mm))
    (condition "A.inDiffPair('*') && A.intersectsCourtyard('U1')"))

# ---------------------------------------------------------------- (3) skew / length matching
# Intra-pair skew <= 0.254 mm (10 mil). One rule per pair: a skew rule measures all nets it
# matches as one group (KiCad 8 adds '(within_diff_pairs)'; per-pair rules also work in 7).
(rule "skew_usb1_d_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'USB1_D_P' || A.NetName == 'USB1_D_N'"))
(rule "skew_usbhs_d_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'USBHS_D_P' || A.NetName == 'USBHS_D_N'"))
(rule "skew_usb2_d_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'USB2_D_P' || A.NetName == 'USB2_D_N'"))
(rule "skew_usb3_d_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'USB3_D_P' || A.NetName == 'USB3_D_N'"))
(rule "skew_usj_d_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'USJ_D_P' || A.NetName == 'USJ_D_N'"))
(rule "skew_csi_d0_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'CSI_D0_P' || A.NetName == 'CSI_D0_N'"))
(rule "skew_csi_d1_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'CSI_D1_P' || A.NetName == 'CSI_D1_N'"))
(rule "skew_csi_clk_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'CSI_CLK_P' || A.NetName == 'CSI_CLK_N'"))
(rule "skew_cam_d0_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'CAM_D0_P' || A.NetName == 'CAM_D0_N'"))
(rule "skew_cam_d1_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'CAM_D1_P' || A.NetName == 'CAM_D1_N'"))
(rule "skew_cam_clk_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'CAM_CLK_P' || A.NetName == 'CAM_CLK_N'"))
(rule "skew_dsi_d0_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'DSI_D0_P' || A.NetName == 'DSI_D0_N'"))
(rule "skew_dsi_d1_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'DSI_D1_P' || A.NetName == 'DSI_D1_N'"))
(rule "skew_dsi_clk_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'DSI_CLK_P' || A.NetName == 'DSI_CLK_N'"))
(rule "skew_disp_d0_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'DISP_D0_P' || A.NetName == 'DISP_D0_N'"))
(rule "skew_disp_d1_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'DISP_D1_P' || A.NetName == 'DISP_D1_N'"))
(rule "skew_disp_clk_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'DISP_CLK_P' || A.NetName == 'DISP_CLK_N'"))
(rule "skew_eth_tx_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'ETH_TX_P' || A.NetName == 'ETH_TX_N'"))
(rule "skew_eth_rx_p"
    (constraint skew (max 0.254mm))
    (condition "A.NetName == 'ETH_RX_P' || A.NetName == 'ETH_RX_N'"))

# MIPI D-PHY inter-lane matching (Espressif: lanes of one link within 0.762 mm / 30 mil).
# KiCad measures each net separately and cannot sum across the 0R series resistors, so the
# SoC-side and connector-side segments are matched separately (tighten on the long side).
(rule "mipi_csi_lane_matching"
    (constraint skew (max 0.762mm))
    (condition "A.NetName == 'CSI_D0_P' || A.NetName == 'CSI_D0_N' || A.NetName == 'CSI_D1_P' || A.NetName == 'CSI_D1_N' || A.NetName == 'CSI_CLK_P' || A.NetName == 'CSI_CLK_N'"))
(rule "mipi_cam_lane_matching"
    (constraint skew (max 0.762mm))
    (condition "A.NetName == 'CAM_D0_P' || A.NetName == 'CAM_D0_N' || A.NetName == 'CAM_D1_P' || A.NetName == 'CAM_D1_N' || A.NetName == 'CAM_CLK_P' || A.NetName == 'CAM_CLK_N'"))
(rule "mipi_dsi_lane_matching"
    (constraint skew (max 0.762mm))
    (condition "A.NetName == 'DSI_D0_P' || A.NetName == 'DSI_D0_N' || A.NetName == 'DSI_D1_P' || A.NetName == 'DSI_D1_N' || A.NetName == 'DSI_CLK_P' || A.NetName == 'DSI_CLK_N'"))
(rule "mipi_disp_lane_matching"
    (constraint skew (max 0.762mm))
    (condition "A.NetName == 'DISP_D0_P' || A.NetName == 'DISP_D0_N' || A.NetName == 'DISP_D1_P' || A.NetName == 'DISP_D1_N' || A.NetName == 'DISP_CLK_P' || A.NetName == 'DISP_CLK_N'"))

# SDIO: CMD/D0-D3 within +/-1.27 mm (50 mil) of SD_CLK. KiCad's skew is measured against the
# longest net of the group (not against CLK), so a 1.27 mm group skew is the closest
# expressible form; it is stricter than or equal to the intent.
(rule "sdio_card_side_matching"
    (constraint skew (max 1.27mm))
    (condition "A.NetName == 'SD_CLK_C' || A.NetName == 'SD_CMD_C' || A.NetName == 'SD_D0_C' || A.NetName == 'SD_D1_C' || A.NetName == 'SD_D2_C' || A.NetName == 'SD_D3_C'"))
(rule "sdio_soc_side_matching"
    (constraint skew (max 1.27mm))
    (condition "A.NetName == 'SD_CLK' || A.NetName == 'SD_CMD' || A.NetName == 'SD_D0' || A.NetName == 'SD_D1' || A.NetName == 'SD_D2' || A.NetName == 'SD_D3'"))

# ---------------------------------------------------------------- (4) thermal vias
# 7x7 GND vias in the EPAD ('U1_EPAD_VIAS' rule area): 0.3 mm drill / 0.6 mm pad, IPC-4761 Type VII (resin-filled + copper-capped, VIPPO).
(rule "thermal_via_size"
    (constraint hole_size (min 0.3mm) (max 0.3mm))
    (constraint via_diameter (min 0.6mm))
    (condition "A.Type == 'Via' && A.intersectsArea('U1_EPAD_VIAS')"))

# ---------------------------------------------------------------- (5) M2.5 heatsink holes
# H1..H4 also carry 'H1_KEEPOUT'.. rule areas (R = 3.5 mm, no tracks/vias).
(rule "m25_hole_to_hole"
    (constraint hole_to_hole (min 0.4mm))
    (condition "A.memberOfFootprint('H1') || A.memberOfFootprint('H2') || A.memberOfFootprint('H3') || A.memberOfFootprint('H4')"))
(rule "m25_hole_clearance"
    (constraint hole_clearance (min 0.5mm))
    (constraint clearance (min 0.3mm))
    (condition "(A.memberOfFootprint('H1') || A.memberOfFootprint('H2') || A.memberOfFootprint('H3') || A.memberOfFootprint('H4')) && B.NetName != 'GND'"))

# ---------------------------------------------------------------- aspirational (comments only)
# * Keep-out height limit (0.60 mm) is mechanical; DRC cannot see component height.
# * Microvia-only fan-out inside U1: (condition "A.Via_Type == 'Micro'") -- property value
#   spelling differs between versions, so the board minimums in the .kicad_pro cover it.
# * Total MIPI/SDIO length through the 0R resistors needs net chaining (not in KiCad 8/9).
